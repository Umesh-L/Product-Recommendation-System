# Copy this file to .env and fill in the values.
# LLM API keys are OPTIONAL — the agent falls back to heuristic rationale if not set.

# ── Option A: OpenAI ──────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# ── Option B: Groq (cheaper / free tier) ──────────────────────
# NOTE: llama-3.1-70b-versatile is DECOMMISSIONED. Use one of the below.
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
#
# Recommended Groq production models (2026):
#   llama-3.3-70b-versatile   (70B, ~280 tok/s, best balanced quality/speed)
#   llama-3.1-8b-instant      (8B,  ~560 tok/s, fastest, cheapest)
#   openai/gpt-oss-120b       (120B, ~500 tok/s, highest quality open model)
# LLM_MODEL=llama-3.3-70b-versatile
